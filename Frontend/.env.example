# Copy to .env and fill in. .env is gitignored - never commit it.
#
# IMPORTANT: every VITE_ variable is inlined into the production JS bundle by
# Vite, so anyone can read it in browser devtools. A VITE_ prefix means "public".
# Only put values here that are safe to publish.

VITE_BASE_URL=

# Firebase web config. Safe to be public - it identifies the project, it does
# not authorize anything. Real protection comes from Firebase Security Rules
# and App Check, not from keeping these hidden.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# WARNING - this one does not belong here.
# A Gemini key authorizes billable API calls. Because it is VITE_ prefixed it
# ships to every visitor's browser (see Frontend/src/Pages/ChatBot.jsx), so it
# is exposed even when .env is not committed. This should move to the Backend
# with the frontend calling your own endpoint instead of Google directly.
VITE_GOOGLE_GEMINI_API_KEY=
